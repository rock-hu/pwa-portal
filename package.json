{
  "name": "pwa-portal",
  "version": "0.0.1",
  "description": "A starter kit for building PWAs!",
  "main": "index.js",
  "scripts": {
    "dev-server": "vite --open",
    "dev": "npm run dev-server",
    "dev-task": "vite",
    "deploy": "gh-pages -d public --dotfiles --nojekyll --user rock.c.c.hu@gmail.com",
    "build": "tsc && vite build",
    "start": "npm run dev",
    "start-remote": "vite --host",
    "webhint": "hint http://localhost:5173",
    "lighthouse:parade": "lighthouse-parade http://localhost:5173 --ignore-robots  --max-crawl-depth  1",
    "lighthouse": "lighthouse http://localhost:5173 --output-path=./lighthouse/lighthouse.html --gather-mode --audit-mode --output html  --quiet"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@shoelace-style/shoelace": "^2.18.0",
    "@thepassle/app-tools": "^0.9.12",
    "lit": "^3.2.1",
    "urlpattern-polyfill": "^10.0.0",
    "workbox-build": "^7.3.0",
    "workbox-core": "^7.3.0",
    "workbox-precaching": "^7.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "hint": "^7.1.13",
    "lighthouse": "^13.0.3",
    "lighthouse-parade": "^2.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.20.5",
    "gh-pages": "^6.1.1"
  },
  "prettier": {
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "quoteProps": "consistent",
    "trailingComma": "es5",
    "endOfLine": "crlf",
    "bracketSpacing": true
  }
}

